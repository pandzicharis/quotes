# ---- VAPID kljucevi za Web Push ----
# Generisi sa: npm install && npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@ammarbasic.ba

# ---- Upstash Redis (Vercel -> Storage -> Redis) ----
# Vercel integracija sama postavi ove varijable
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Zastita cron endpointa (/api/send, /api/test) ----
# Ista vrijednost koju cron servis salje kao zaglavlje:  x-cron-secret: <tajna>
# Prihvata se i  Authorization: Bearer <tajna>  i  ?secret=<tajna>
CRON_SECRET=
