# ---- VAPID kljucevi za Web Push ----
# Generisi sa: npm install && npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@ammarbasic.ba

# ---- Supabase (baza pretplata i instalacija) ----
# Supabase -> Project Settings -> API keys
#   SUPABASE_URL          https://<projekat>.supabase.co
#   SUPABASE_SECRET_KEY   tajni kljuc: sb_secret_... (ili stari service_role JWT)
#
# PAZI: publishable / anon kljuc ovdje NE radi. Tabele su pod RLS-om bez
# ijedne politike, pa mu Postgres ne da ni jedan red — i tako mora ostati,
# jer u tabeli `pretplate` stoje kriptografski kljucevi tudih uredaja.
# Kod prihvata i imena NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY,
# a /api/status u polju `bazaVarijable` kaze koje je zaista nasao.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---- Upstash Redis — samo za jednokratnu seobu (scripts/prebaci.js) ----
# Aplikacija ovo vise ne cita. Popuni ako jos ima starih pretplata u Redisu,
# pokreni seobu, pa obrisi i ove dvije linije.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Zastita cron endpointa (/api/send, /api/test) ----
# Ista vrijednost koju cron servis salje kao zaglavlje:  x-cron-secret: <tajna>
# Prihvata se i  Authorization: Bearer <tajna>  i  ?secret=<tajna>
CRON_SECRET=
