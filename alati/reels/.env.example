# Radnik za reelse — kopiraj u .env i upiši vrijednosti (.env ne ide u git).

# Supabase projekat (za test: poruka-dana-test) → Project Settings → API Keys
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Groq (besplatno, console.groq.com → API Keys): transkript; rezerva za AI
GROQ_API_KEY=

# Google AI Studio (besplatno, aistudio.google.com → Get API key): izbor, ispravke, rezovi
GEMINI_API_KEY=

# Bez Groq/Gemini ključeva radnik koristi faster-whisper (procesor) i Ollamu na Macu — radi, ali sporije.

# Nije obavezno:
# REELS_GEMINI_MODEL=gemini-2.5-flash      (inače se sam bira najnoviji gemini-…-flash)
# REELS_GROQ_WHISPER=whisper-large-v3-turbo (podrazumijevano whisper-large-v3)
# REELS_OLLAMA=http://host.docker.internal:11434
